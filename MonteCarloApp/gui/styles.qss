/* =========================
   LIGHT CLASSIC THEME
   ========================= */

QWidget {
    background: #f2f2f2;
    color: #222;
    font-family: "Helvetica", "Arial";
    font-size: 13px;
}

/* GroupBox (cadre paramètres / résultats) */
QGroupBox {
    background: #f7f7f7;
    border: 1px solid #cfcfcf;
    border-radius: 6px;
    margin-top: 14px;
    padding: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #1f4e79;
    font-weight: bold;
}

/* Inputs */
QLineEdit, QComboBox {
    background: white;
    border: 1px solid #c7c7c7;
    border-radius: 4px;
    padding: 6px 8px;
    min-height: 26px;
}
QComboBox::drop-down {
    border-left: 1px solid #c7c7c7;
    width: 24px;
}


QPushButton {
    background: #1f77b4;
    color: white;
    border: 1px solid #1a4f7d;
    border-radius: 5px;
    padding: 8px 14px;
    font-weight: bold;
}
QPushButton:hover {
    background: #155a8a;
}
QPushButton:pressed {
    background: #1f5f97;
}

/* Table */
QTableWidget {
    background: white;
    border: 1px solid #cfcfcf;
    gridline-color: #dcdcdc;
    border-radius: 6px;
}
QHeaderView::section {
    background: #e8eef6;
    color: #1f4e79;
    font-weight: bold;
    border: 1px solid #d0d7e2;
    padding: 6px;
}

/* Onglets (si tu utilises QTabWidget) */
QTabWidget::pane {
    border: 1px solid #cfcfcf;
    background: #f7f7f7;
}
QTabBar::tab {
    background: #e6e6e6;
    border: 1px solid #cfcfcf;
    padding: 8px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #3b83c0;
    color: white;
    font-weight: bold;
}
